/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow.config — EPICflow (Meffil Methylation Pipeline)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Profiles:
        local   — Pop!_OS desktop (eiko), ~30 GB RAM, 12 cores
                  Memory directives are ADVISORY only (no scheduler enforcement).
                  executor.memory = false disables the "req > avail" launch gate.

        chpc    — CHPC Lengau PBS scheduler
                  Queue strategy mirrors H3Aflow:
                    seriallong : long single-node jobs    (max 12 cores, 144h)
                    serial     : downstream/medium jobs   (max 23 cores, 48h)
                    smp        : memory-heavy single-node (min 24 cores, 96h)
                  Light bookkeeping processes run on the head node (executor='local').

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ── Reporting / tracing (always on) ──────────────────────────────────────────
dag.enabled      = true
timeline.enabled = true
report.enabled   = true

// ── Global params ─────────────────────────────────────────────────────────────
params {

    // ── Mandatory inputs ─────────────────────────────────────────────────────
    samplesheet    = null       // study-level CSV: Sample_ID, Sentrix_Position, Plate_Number, ...
    idat_dir       = null       // root directory containing per-plate IDAT subdirectories
    out_dir        = "${projectDir}/results"

    // ── R / Rscript interpreter ───────────────────────────────────────────────
    // Overridden per-profile so local desktop and Lengau each use their own
    // conda-env Rscript. All module files reference ${params.rscript}.
    rscript        = "Rscript"  // safe fallback

    // ── Conda environment ─────────────────────────────────────────────────────
    conda_env      = "meffil_epicv2"

    // ── QC thresholds ────────────────────────────────────────────────────────
    qc_thresh      = 0.95       // minimum sample call rate (pipeline PASS/FAIL)

    // ── Normalization ─────────────────────────────────────────────────────────
    norm_n_pcs     = 0          // control-probe PCs for functional normalization
                                // 0 = auto-select via cross-validated scree plot
                                // (paper recommends ~10; auto finds the elbow)

    // ── Genotype concordance ──────────────────────────────────────────────────
    conc_cutoff    = 0.99       // concordance threshold to flag likely duplicates
    conc_min_snps  = 50         // min jointly-called SNPs for a reliable comparison

    // ── Cross-study / H3A concordance (optional) ─────────────────────────────
    h3a_bfile      = null       // PLINK bfile prefix for H3A reference panel
                                // leave null to skip IDENTITY_CHECK and H3A_CONCORDANCE
    h3a_match_thresh = 0.80     // minimum SNP-match rate to the H3A panel
    snp_names_file = "${projectDir}/bin/snp-names.txt"
    id_map_file    = null       // sample-ID mapping CSV; null = best-match only

    // ── Trace directory ───────────────────────────────────────────────────────
    tracedir       = "${params.out_dir}/pipeline_info"
}

// ── Base process defaults (fallback for any process not listed below) ─────────
process {
    cpus   = 4
    memory = '8 GB'
    time   = '4h'
    shell  = ['/bin/bash', '-euo', 'pipefail']

    // Light, single-threaded bookkeeping
    withName: 'SPLIT_SAMPLESHEET'  { cpus = 1; memory = '4 GB';  time = '30m' }
    withName: 'MERGE_SAMPLESHEETS' { cpus = 1; memory = '4 GB';  time = '30m' }

    // Per-plate QC — parallelised with mclapply inside meffil.qc()
    withName: 'PLATE_QC'           { cpus = 4; memory = '28 GB'; time = '3h'  }

    // Combined normalisation — parallelised; writes to GDS (low memory peak)
    withName: 'COMBINED_NORMALIZE' { cpus = 4; memory = '28 GB'; time = '4h'  }

    // Concordance checks
    withName: 'GENOTYPE_CONCORDANCE'   { cpus = 2; memory = '8 GB';  time = '1h'  }
    withName: 'IDENTITY_CHECK_PRE_QC'  { cpus = 2; memory = '8 GB';  time = '1h'  }
    withName: 'H3A_CONCORDANCE'        { cpus = 2; memory = '8 GB';  time = '1h'  }
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {

    // ─────────────────────────────────────────────────────────────────────────
    // local — Pop!_OS desktop (eiko), ~30.5 GB available, 12 cores
    // ─────────────────────────────────────────────────────────────────────────
    local {

        process.executor = 'local'
        conda.enabled    = true
        conda.cacheDir   = "${HOME}/.conda/envs"

        // Disable the "req > avail" memory launch gate for local runs.
        // Memory directives are still passed to R scripts as max_gb so they
        // can size their mclapply forks — they just don't block job launch.
        executor {
            cpus   = 12
            memory = false
        }

        // Desktop-appropriate resource caps (fit within ~30.5 GB)
        process {
            withName: 'PLATE_QC' {
                cpus   = 4
                memory = '24 GB'   // passed to R as max_gb; ~6 GB/fork × 4 cores
                time   = '3h'
            }
            withName: 'COMBINED_NORMALIZE' {
                cpus   = 4
                memory = '24 GB'   // GDS path peaks ~3 GB; headroom for PCA + reports
                time   = '4h'
            }
            withName: 'GENOTYPE_CONCORDANCE' {
                cpus   = 2
                memory = '8 GB'
                time   = '1h'
            }
            withName: 'H3A_CONCORDANCE' {
                cpus   = 2
                memory = '8 GB'
                time   = '1h'
            }
        }

        params {
            rscript   = "Rscript"
            conda_env = "meffil_epicv2"
            out_dir   = "${projectDir}/results"
            tracedir  = "${projectDir}/results/pipeline_info"
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // chpc — CHPC Lengau PBS scheduler
    //
    // Queue rotation mirrors H3Aflow to spread load evenly:
    //   task.index % 3 == 0  → serial
    //   task.index % 3 == 1  → seriallong
    //   task.index % 3 == 2  → smp       (requires min 24 cores)
    //
    // PLATE_QC runs per-plate in parallel (6 jobs) — rotated across queues.
    // COMBINED_NORMALIZE is a single large job — assigned to seriallong.
    // Light bookkeeping runs on the head node (executor = 'local').
    // ─────────────────────────────────────────────────────────────────────────
    chpc {

        process.executor    = 'pbs'
        process.queue       = 'seriallong'   // default queue; overridden per process
        process.clusterOptions = '-P CBBI1105'

        executor.queueSize       = 20
        executor.submitRateLimit = '10/1min'
        executor.cpus            = 30

        conda.enabled  = true
        conda.cacheDir = '/mnt/lustre/users/gbimoko/conda_envs'

        process.beforeScript = """
            export NXF_WORK=/mnt/lustre/users/gbimoko/EPICflow/work
            export NXF_TEMP=/mnt/lustre/users/gbimoko/.nextflow_tmp

            module load chpc/BIOMODULES
            module load R/4.2.0
            module load java/24.0.1
            module load chpc/nextflow/25.04.4

            source /home/gbimoko/miniforge3/etc/profile.d/conda.sh
            conda activate /mnt/lustre/users/gbimoko/conda_envs/meffil_epicv2
        """

        params {
            rscript   = "/mnt/lustre/users/gbimoko/conda_envs/meffil_epicv2/bin/Rscript"
            conda_env = "/mnt/lustre/users/gbimoko/conda_envs/meffil_epicv2"
            out_dir   = "/mnt/lustre/users/gbimoko/EPICflow/results"
            tracedir  = "/mnt/lustre/users/gbimoko/EPICflow/results/pipeline_info"
        }

        process {

            // ── Head-node bookkeeping (no PBS submission) ─────────────────
            withName: 'SPLIT_SAMPLESHEET' {
                executor = 'local'
                cpus     = 1
                memory   = '4 GB'
                time     = '30m'
            }
            withName: 'MERGE_SAMPLESHEETS' {
                executor = 'local'
                cpus     = 1
                memory   = '4 GB'
                time     = '30m'
            }

            // ── Per-plate QC — 6 jobs submitted in parallel ───────────────
            // Rotated across serial / seriallong / smp to stay within the
            // 10-job-per-queue running limit on Lengau.
            // smp requires min 24 cores.
            withName: 'PLATE_QC' {
                queue  = { (task.index % 3 == 0) ? 'serial'
                         : (task.index % 3 == 1) ? 'seriallong'
                         :                          'smp' }
                cpus   = { (task.queue == 'smp') ? 24 : 8 }
                memory = '32 GB'
                time   = '4h'
            }

            // ── Combined normalisation — single large job ─────────────────
            // Writes to GDS so memory stays low even for large cohorts.
            // seriallong gives 144h headroom if meffil.plot.pc.fit is slow.
            withName: 'COMBINED_NORMALIZE' {
                queue  = 'seriallong'
                cpus   = 12
                memory = '64 GB'
                time   = '6h'
            }

            // ── Concordance — moderate memory, rotate queues ──────────────
            withName: 'GENOTYPE_CONCORDANCE' {
                queue  = { (task.index % 3 == 0) ? 'serial'
                         : (task.index % 3 == 1) ? 'seriallong'
                         :                          'smp' }
                cpus   = { (task.queue == 'smp') ? 24 : 4 }
                memory = '8 GB'
                time   = '2h'
            }
            withName: 'IDENTITY_CHECK_PRE_QC' {
                queue  = { (task.index % 3 == 0) ? 'serial'
                         : (task.index % 3 == 1) ? 'seriallong'
                         :                          'smp' }
                cpus   = { (task.queue == 'smp') ? 24 : 4 }
                memory = '8 GB'
                time   = '2h'
            }
            withName: 'H3A_CONCORDANCE' {
                queue  = { (task.index % 3 == 0) ? 'serial'
                         : (task.index % 3 == 1) ? 'seriallong'
                         :                          'smp' }
                cpus   = { (task.queue == 'smp') ? 24 : 4 }
                memory = '16 GB'
                time   = '2h'
            }
        }
    }

} // ← closes profiles

// ── Reporting outputs ─────────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag.svg"
}
