profiles {
    local {
        process {
            executor = 'local'
            shell    = '/bin/bash'
            conda    = true

            withName: 'GROUP_BY_PLATE' {
                cpus   = 1
                memory = '4 GB'
            }

            withName: 'CREATE_SAMPLESHEETS' {
                cpus   = 1
                memory = '2 GB'
            }

            withName: 'PLATE_QC' {
                cpus   = 4
                memory = '16 GB'
            }

            withName: 'COMBINED_NORMALIZE' {
                cpus   = 1      // single-threaded to avoid pthread errors
                memory = '32 GB'
            }

            withName: 'MERGE_SAMPLESHEETS' {
                cpus   = 1
                memory = '4 GB'
            }

            withName: 'GENOTYPE_CONCORDANCE' {
                cpus   = 2
                memory = '8 GB'
                // Pure Python + R: no threading issues; memory scales with N^2 pairs
                // 8 GB is ample for up to ~2000 samples (4M pairs, small SNP matrix)
            }

            withName: 'H3A_CONCORDANCE' {
                cpus   = 2
                memory = '8 GB'
                // Runs match_h3a_snps.r (R + PLINK) then cross_study_concordance.py
                // Memory scales with n_epic × n_h3a pairs; 8 GB handles ~5000 × 5000
            }
        }

        conda {
            enabled  = true
            cacheDir = "${HOME}/.conda/envs"
        }
    }

    pbs {
        process {
            executor = 'pbs'

            withName: 'GROUP_BY_PLATE' {
                cpus   = 1
                memory = '4 GB'
                time   = '1h'
            }

            withName: 'CREATE_SAMPLESHEETS' {
                cpus   = 1
                memory = '2 GB'
                time   = '30m'
            }

            withName: 'PLATE_QC' {
                cpus   = 8
                memory = '32 GB'
                time   = '4h'
            }

            withName: 'COMBINED_NORMALIZE' {
                cpus   = 1
                memory = '64 GB'
                time   = '6h'
            }

            withName: 'MERGE_SAMPLESHEETS' {
                cpus   = 1
                memory = '4 GB'
                time   = '30m'
            }

            withName: 'GENOTYPE_CONCORDANCE' {
                cpus   = 4
                memory = '8 GB'
                time   = '1h'
            }

            withName: 'H3A_CONCORDANCE' {
                cpus   = 4
                memory = '16 GB'
                time   = '2h'
                // Extra memory/time for large H3A datasets (many thousands of samples)
            }
        }

        conda {
            enabled  = true
            cacheDir = "${HOME}/.conda/envs"
        }
    }
}
